@test module;

import ^^.*;
import ^.helpers.*;
import hc: ^^^.hybridcompute;
import hch: ^^^.hybridcompute.test.helpers;

function test_ai_inference_success() {
    rell.test.tx().op(
        submit_inference_request_op("one", "ABCD")
    ).run();
    assert_null(fetch_inference_result("one"));

    rell.test.tx().op(
        hch.request_taken_op("one")
    ).run();
    rell.test.tx().op(
        hch.response_op("one", "ai_inference", response(prompt="ABCD", generated="ABCD 1234").to_gtv_pretty())
    ).run();
    assert_equals(fetch_inference_result("one"), inference_result(result="ABCD 1234", error=null,
        tx_rid=transaction @ { } (@omit @sort_desc .rowid, .tx_rid) limit 1, op_index=0));

}

function test_ai_inference_failure() {
    rell.test.tx().op(
        submit_inference_request_op("two", "ABCD")
    ).run();
    assert_null(fetch_inference_result("two"));

    rell.test.tx().op(
        hch.request_taken_op("two")
    ).run();
    rell.test.tx().op(
        hch.failure_op("two", "ai_inference", "fel fel fel")
    ).run();
    assert_equals(fetch_inference_result("two"), inference_result(result=null, error="fel fel fel",
        tx_rid=transaction @ { } (@omit @sort_desc .rowid, .tx_rid) limit 1, op_index=0));

}
