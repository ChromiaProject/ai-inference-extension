module;

import hc: ^.hybridcompute;

struct request {
    prompt: text;
}

struct response {
    prompt: text;
    generated: text;
}

// TODO need something to force generation of code for the structs
query bogus(request): response = response(prompt = request.prompt, generated = "bogus");

val type = "ai_inference";

function submit_inference_request(id: text, prompt: text) {
    hc.submit_compute_request(id, type, request(prompt).to_gtv_pretty());
}

function fetch_inference_result(id: text): (result: text?, error: text?) {
    val (result, error) = hc.fetch_compute_result(id);
    if (result != null) {
        return (result = response.from_gtv_pretty(result).generated, error = null);
    } else {
        return (result = null, error = error);
    }
}
